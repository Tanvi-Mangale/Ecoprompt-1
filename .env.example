# Copy this file to a new file named .env.local and put your real key in it.
# Never commit .env.local. Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional: choose the model (no quotes, no "models/" prefix).
# If it is missing or unavailable, the app falls back to other current Gemini models.
GEMINI_MODEL=gemini-3.8-flash
